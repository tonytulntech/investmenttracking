# Supabase (login e sincronizzazione dati). Senza queste variabili l'app gira
# in modalità locale, senza account (comportamento storico).
# La anon key è pubblica per progetto; NON inserire mai la service_role key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
